# Token gerado no painel do Melhor Envio (produção e sandbox usam tokens diferentes).
MELHOR_ENVIO_TOKEN=
# "production" (padrão) ou "sandbox"
MELHOR_ENVIO_ENV=production
# Obrigatório pela API: nome da aplicação + e-mail de contato técnico.
# Pode ser só o e-mail; o app completa como "Cotador de Fretes (e-mail)".
MELHOR_ENVIO_USER_AGENT="Cotador de Fretes (contato@empresa.com.br)"

# Senha única da equipe, pedida na tela /entrar.
APP_PASSWORD=
# Segredo que assina o cookie de sessão. Mínimo de 32 caracteres aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Dados completos do remetente por origem, em JSON de uma linha. Fica fora do código porque o repositório é público.
# Formato: {"poa": {...}, "scs": {...}}, cada um com name, phone, email, companyDocument (ou document),
# stateRegister, economicActivityCode, address, number, complement, district, city, postalCode, stateAbbr.
SENDERS_JSON=

# Integração com o Vibe (busca de pedido para cotação e etiqueta). Opcional: sem as duas, o quadro não aparece.
# Endereço completo até /pedidos, sem barra no fim.
VIBE_API_URL=
# Chave de acesso entregue pelo Vibe. Nunca em arquivo versionado.
VIBE_API_KEY=
